{
    "name": "hforlife/filament-theme-studio",
    "description": "A visual theme customization studio for Filament panels.",
    "keywords": ["css", "filament", "filament-plugin", "filamentphp", "laravel", "theme"],
    "homepage": "https://github.com/hforlife/Filament_Theme_Studio",
    "support": {
        "issues": "https://github.com/hforlife/Filament_Theme_Studio/issues",
        "source": "https://github.com/hforlife/Filament_Theme_Studio"
    },
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0 || ^5.0",
        "spatie/laravel-package-tools": "^1.15"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.7 || ^4.0",
        "pestphp/pest-plugin-arch": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {"psr-4": {"Hforlife\\FilamentThemeStudio\\": "src/", "Hforlife\\FilamentThemeStudio\\Database\\Factories\\": "database/factories/"}},
    "autoload-dev": {"psr-4": {"Hforlife\\FilamentThemeStudio\\Tests\\": "tests/"}},
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse --debug",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run --debug"
    },
    "extra": {"laravel": {"providers": ["Hforlife\\FilamentThemeStudio\\FilamentThemeStudioServiceProvider"]}},
    "config": {
        "sort-packages": true,
        "allow-plugins": {"pestphp/pest-plugin": true, "phpstan/extension-installer": true}
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
